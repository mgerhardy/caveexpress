NÃâA›{Ð‰Ù°Ó‹Ž@Ït_—O*VÐÑ'´P3ê6ƒ.õ93­¥‚¤ˆ5µ/!5«&úºa“ŸxRêÄVõ|adâkc¹¬[¸@wÔÞ»ºÆÙØY“ï\.ÚÒáðòÁŒ2:ÌËk7Ê,Ù9o…0˜ÁÝ-kY`<s÷ô‹Ò$è+ýQÊk“lÙUËÙ=XÄD6ýú`~· ␀q74yæœ@d¦=#PËm˜ÙWu¢|Ú¼­=uciT¼ç]õ"érjüÛ]^{–åWôëg`ån^>ÀÏï-vj·)}S*Ù;iqèy¡¸·ø»ð£Ü—Ã—?êSM5ÜãÊö¤úÂßér‰ÕnÜÒ•³ÝÞ*„ž®Ó¨ºOkÍÿ™␀#‹$h­ˆ8;'Â~`²¬pð1cY¯É¯Á$ ÎÂÁÁ'Ç 'ÎÂÎ4E’␀üs½×%tIÎ␀␀␀␀IEND®B`‚uniform sampler2D u_texture;
in vec2 v_texcoord;
in vec4 v_color;
out vec4 o_color;

void main(void) {
	vec4 color = texture2D(u_texture, v_texcoord);
	vec4 fcolor = v_color / 255.0;
	o_color = color * fcolor * 255.0;
}
// attributes from the VAOs
in vec2 a_pos;
in vec2 a_texcoord;
in vec4 a_color;

uniform mat4 u_projection;

out vec2 v_texcoord;
out vec4 v_color;

void main(void) {
	v_color = a_color;
	v_texcoord = a_texcoord;
	gl_Position = u_projection * vec4(a_pos.x, a_pos.y, 0.0, 1.0);
}
